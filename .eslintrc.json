{
    "env": {
        "browser": true,
        "es6": true
    },
    "extends": [
        "google"
    ],
    "globals": {
        "Atomics": "readonly",
        "SharedArrayBuffer": "readonly"
    },
    "parserOptions": {
        "ecmaVersion": 6,
        "sourceType": "module"
    },
    "rules": {
        "require-jsdoc": "off",
        "max-len": ["warn", {
            "code": 80,
            "tabWidth": 2,
            "ignoreUrls": true,
            "ignoreStrings": true
          }]
    }    
}

