{
  "name": "aritmates",
  "version": "1.3.0",
  "description": "Aplicación web estática de ejercicios de matemáticas (Aritmates) — versión simplificada",
  "private": true,
  "type": "module",
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "vendor": "node scripts/copy-vendor.mjs",
    "build": "node scripts/build.mjs",
    "dev": "node scripts/build.mjs && node scripts/serve.mjs",
    "serve": "node scripts/serve.mjs",
    "test": "node scripts/test.mjs",
    "test:ci": "node scripts/test.mjs",
    "test:all": "node scripts/test.mjs",
    "check": "node scripts/check-assets.mjs",
    "visual": "node scripts/visual-gallery.mjs",
    "e2e": "playwright test",
    "coverage": "c8 --reporter=text-summary node scripts/test.mjs",
    "coverage:ci": "c8 --all --exclude-after-remap --reporter=text-summary --check-coverage --lines 90 --functions 90 --branches 85 --statements 90 --include=src/operaciones/arithmetic.js --include=src/operaciones/evaluate.js --include=src/operaciones/expression.js --include=src/operaciones/random.js node scripts/test.mjs",
    "audit": "npm audit --audit-level=high",
    "lint": "eslint ."
  },
  "dependencies": {
    "@fortawesome/fontawesome-free": "^7.3.1",
    "bootstrap": "^5.3.8",
    "decimal.js": "^10.6.0",
    "html2canvas": "^1.4.1",
    "iv-viewer": "^2.2.1",
    "jquery": "^4.0.0",
    "jspdf": "^4.2.1",
    "material-design-icons": "^3.0.1",
    "placeholder-loading": "^0.7.0",
    "roboto-fontface": "^0.10.0"
  },
  "devDependencies": {
    "c8": "^12.0.0",
    "chai": "^6.2.2",
    "chai-match": "^1.1.1",
    "esbuild": "^0.28.2",
    "eslint": "^10.11.0",
    "mocha": "^12.0.2",
    "playwright": "^1.63.0",
    "sass": "^1.104.1"
  },
  "author": "Área de Tecnología Educativa <ate.educacion@gobiernodecanarias.org>",
  "contributors": [
    "Fernando Ramírez Pérez <fernando.ramirez@altia.es>",
    "Área de Tecnología Educativa <ate.educacion@gobiernodecanarias.org> (versión simplificada 1.3+)"
  ],
  "license": "AGPL-3.0",
  "homepage": "https://ateeducacion.github.io/aritmates/",
  "engines": {
    "node": ">=24"
  },
  "overrides": {
    "brace-expansion": "5.0.9",
    "mocha": {
      "diff": "^8.0.3",
      "serialize-javascript": "^7.0.5"
    }
  },
  "allowScripts": {
    "@parcel/watcher@2.5.1": false,
    "core-js@3.49.0": false,
    "esbuild@0.28.2": true
  }
}
