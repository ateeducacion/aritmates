{
  "name": "aritmates",
  "version": "1.1.0",
  "description": "Aplicación web estática de ejercicios de matemáticas (Aritmates) — versión simplificada",
  "private": true,
  "type": "module",
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "vendor": "node scripts/copy-vendor.mjs",
    "build": "node scripts/build.mjs",
    "dev": "node scripts/build.mjs && node scripts/serve.mjs",
    "serve": "node scripts/serve.mjs",
    "test": "node scripts/test.mjs --ci",
    "test:ci": "node scripts/test.mjs --ci",
    "test:all": "node scripts/test.mjs --all",
    "check": "node scripts/check-assets.mjs",
    "visual": "node scripts/visual-gallery.mjs",
    "lint": "eslint './src/**/*.js' || true"
  },
  "dependencies": {
    "@fortawesome/fontawesome-free": "^6.7.2",
    "@material/dialog": "^14.0.0",
    "@material/drawer": "^14.0.0",
    "@material/mwc-switch": "^0.27.0",
    "@material/textfield": "^14.0.0",
    "@polymer/iron-a11y-announcer": "^3.2.0",
    "@polymer/iron-collapse": "^3.0.1",
    "@polymer/iron-flex-layout": "^3.0.1",
    "@polymer/iron-icons": "^3.0.1",
    "@polymer/paper-dropdown-menu": "^3.2.0",
    "@polymer/paper-icon-button": "^3.0.2",
    "@polymer/paper-item": "^3.0.1",
    "@polymer/paper-listbox": "^3.0.1",
    "@polymer/paper-styles": "^3.0.1",
    "@polymer/polymer": "^3.5.2",
    "bootstrap": "^5.3.8",
    "combinations": "^1.0.0",
    "decimal.js": "^10.6.0",
    "html2canvas": "^1.4.1",
    "iv-viewer": "^2.2.1",
    "jquery": "^3.7.1",
    "jspdf": "^3.0.0",
    "placeholder-loading": "^0.7.0",
    "roboto-fontface": "^0.10.0",
    "shallow-equal": "^3.1.0",
    "shorthash": "^0.0.2",
    "webpack-material-design-icons": "^0.1.0",
    "xy-ui": "^1.10.7"
  },
  "devDependencies": {
    "chai": "^5.3.3",
    "chai-match": "^1.1.1",
    "esbuild": "^0.25.12",
    "eslint": "^8.57.1",
    "eslint-config-google": "^0.14.0",
    "mocha": "^11.7.5",
    "playwright": "^1.51.0",
    "sass": "^1.99.0"
  },
  "author": "Área de Tecnología Educativa",
  "license": "AGPL-3.0",
  "homepage": "https://github.com/ateeducacion/aritmates",
  "engines": {
    "node": ">=18"
  },
  "overrides": {
    "mocha": {
      "diff": "^8.0.3",
      "serialize-javascript": "^7.0.5"
    }
  },
  "allowScripts": {
    "esbuild@0.25.12": true
  }
}
